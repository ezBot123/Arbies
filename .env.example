# Copy to .env and fill in. NEVER commit .env. Placeholders only below.

# --- Database (docker-compose uses POSTGRES_*; local dev uses ARBIES_DATABASE_URL) ---
POSTGRES_USER=arbies
POSTGRES_PASSWORD=change-me
POSTGRES_DB=arbies
ARBIES_DATABASE_URL=postgresql+asyncpg://arbies:change-me@localhost:5432/arbies

# --- Authentication ---
ARBIES_ADMIN_USERNAME=admin
ARBIES_ADMIN_PASSWORD=change-me-to-a-long-random-password
ARBIES_SESSION_TTL_HOURS=12
ARBIES_COOKIE_SECURE=false            # true when served over HTTPS
ARBIES_CORS_ORIGINS=["http://localhost:5173"]

# --- Credential encryption (Fernet key). Generate with:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ARBIES_SECRET_KEY=

# --- Market data ---
ARBIES_MARKET_DATA_MODE=live          # live | synthetic | off
ARBIES_EXCHANGES=["kraken","coinbase","bitstamp"]
ARBIES_SYMBOLS=["BTC/USD","ETH/USD","ETH/BTC","BTC/GBP","ETH/GBP","USDC/USD"]
ARBIES_RECORD_MARKET_DATA=true
ARBIES_RECORD_INTERVAL_MS=1000
ARBIES_DATA_RETENTION_DAYS=30

# --- Strategy / paper defaults (research placeholders, not profitability claims) ---
ARBIES_PAPER_INITIAL_CAPITAL_GBP=500
ARBIES_MAX_TRADE_SIZE_GBP=25
ARBIES_MIN_NET_PROFIT_PCT=0.30

# --- Live trading: keep false. Enabling still requires the in-app arming flow. ---
ARBIES_LIVE_TRADING_ENABLED=false

# --- AI providers (optional; agents work without them) ---
ARBIES_AI_PROVIDER=none               # none | anthropic | openai
ARBIES_ANTHROPIC_API_KEY=
ARBIES_ANTHROPIC_MODEL=claude-opus-5-5
ARBIES_OPENAI_API_KEY=
ARBIES_OPENAI_BASE_URL=
ARBIES_OPENAI_MODEL=
ARBIES_AI_MONTHLY_BUDGET_USD=20
ARBIES_AGENTS_SCHEDULE_ENABLED=false
ARBIES_AGENTS_SCHEDULE_USE_LLM=false

ARBIES_LOG_LEVEL=INFO
ARBIES_LOG_JSON=false
